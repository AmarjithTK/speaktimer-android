<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <!-- Small branding title -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SolasFlow"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:gravity="start"
        android:layout_marginBottom="4dp" />

    <!-- Row 1: 1 · 2 · 3 · 5 · 7 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <TextView android:id="@+id/btn_1m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="1" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_2m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="2" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_3m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="3" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_5m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="5" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_7m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
    </LinearLayout>

    <!-- Row 2: 10 · 12 · 15 · 20 · 25 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <TextView android:id="@+id/btn_10m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="10" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_12m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="12" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_15m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="15" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_20m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="20" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_25m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="25" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
    </LinearLayout>

    <!-- Row 3: 30 · 35 · 45 · 60 · 90 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/btn_30m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="30" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_35m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="35" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_45m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="45" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_60m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:text="60" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
        <TextView android:id="@+id/btn_90m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="90" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:gravity="center" android:background="@drawable/widget_button_bg" />
    </LinearLayout>

</LinearLayout>
