<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Timer value — large, centered -->
    <TextView
        android:id="@+id/widget_timer_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="#FFFFFFFF"
        android:textSize="42sp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Row 1: 5 m · 10 m · 15 m · 20 m · 25 m -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/btn_5m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="5m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFCC5500" />

        <TextView
            android:id="@+id/btn_10m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="10m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFCC5500" />

        <TextView
            android:id="@+id/btn_15m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="15m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFCC5500" />

        <TextView
            android:id="@+id/btn_20m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="20m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFCC5500" />

        <TextView
            android:id="@+id/btn_25m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="25m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFDD6600" />
    </LinearLayout>

    <!-- Row 2: 30 m · 45 m · 60 m · 90 m · 120 m -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/btn_30m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="30m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFCC5500" />

        <TextView
            android:id="@+id/btn_45m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="45m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFCC5500" />

        <TextView
            android:id="@+id/btn_60m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="60m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFCC5500" />

        <TextView
            android:id="@+id/btn_90m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="90m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFCC5500" />

        <TextView
            android:id="@+id/btn_120m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="120m"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textAllCaps="false"
            android:gravity="center"
            android:background="#FFCC5500" />
    </LinearLayout>

    <!-- Minimal branding -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Solas flow"
        android:textColor="#55FFFFFF"
        android:textSize="9sp"
        android:fontFamily="sans-serif"
        android:gravity="end"
        android:layout_marginTop="1dp" />

</LinearLayout>
